# Copia este archivo como .env y completa los valores

# MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=places_crm
# Zona horaria de la sesión MySQL (Perú = -05:00)
DB_TZ=-05:00

# Servidor
PORT=3010
NODE_ENV=production
# Pon 1 cuando el sitio se sirva por HTTPS (cookies Secure + HSTS)
COOKIE_SECURE=0
# Número de proxies delante de Node (nginx = 1)
TRUST_PROXY=1

# Usuario administrador inicial (solo se usa si la tabla usuarios está vacía).
# Deberá cambiar la contraseña en el primer ingreso. Bórralos luego de iniciar.
ADMIN_EMAIL=admin@tu-empresa.com
ADMIN_PASSWORD=

# Se generan solos en el primer arranque si faltan. NO los compartas ni los pierdas:
# APP_KEY cifra los tokens de Meta/Google guardados en la base de datos.
# JWT_SECRET=
# APP_KEY=

# Opcional: API key de Google (también se puede cargar desde Configuración)
# GOOGLE_API_KEY=
